#!/usr/bin/env bash
# Boot a built image in QEMU and wait for the login prompt on the serial console.
# Usage: tools/qemu-smoke IMAGE [MODE] [timeout-seconds]
#   MODE: uefi | secureboot | bios | all (default all). "all" runs the three modes one after another and
#   exits non-zero if any of them fails.
# Needs qemu-system-x86_64 and OVMF (package ovmf). Acceleration: KVM when /dev/kvm is writable (Linux, CI),
# WHPX on Windows (Git Bash with a Windows QEMU), else slow software emulation. Override with QEMU_ACCEL.
# Secure Boot mode also checks that the kernel reports "Secure boot enabled", so a boot that quietly
# skipped Secure Boot cannot pass.
set -euo pipefail

image=${1:?usage: qemu-smoke IMAGE [uefi|secureboot|bios|all] [timeout]}
mode=${2:-all}
timeout_s=${3:-240}

if [[ $mode == all ]]; then
  failed=0
  for m in uefi secureboot bios; do
    "$0" "$image" "$m" "$timeout_s" || failed=1
  done
  exit "$failed"
fi

ovmf_dir=${OVMF_DIR:-/usr/share/OVMF}
qemu=${QEMU:-qemu-system-x86_64}

accel=${QEMU_ACCEL:-}
if [[ -z $accel ]]; then
  case $(uname -s) in
    MINGW* | MSYS* | CYGWIN*) accel=whpx ;;
    *) if [[ -w /dev/kvm ]]; then accel=kvm; else accel=tcg; fi ;;
  esac
fi

log=$(mktemp)
vars=$(mktemp)
trap 'rm -f "$log" "$vars"' EXIT

# snapshot=on keeps the image unchanged, so the same file can be booted again or flashed.
args=(-m 2048 -smp 2 -display none -drive "file=$image,format=raw,snapshot=on"
  -serial "file:$log" -no-reboot)

case $mode in
  uefi)
    cp "$ovmf_dir/OVMF_VARS_4M.fd" "$vars"
    args+=(-machine "q35,accel=$accel"
      -drive "if=pflash,format=raw,readonly=on,file=$ovmf_dir/OVMF_CODE_4M.fd"
      -drive "if=pflash,format=raw,file=$vars")
    ;;
  secureboot)
    # OVMF_VARS_4M.ms.fd already holds the Microsoft keys with Secure Boot enabled; Canonical's shim is
    # signed by the Microsoft UEFI CA. SMM must be on for the secure firmware.
    cp "$ovmf_dir/OVMF_VARS_4M.ms.fd" "$vars"
    args+=(-machine "q35,accel=$accel,smm=on"
      -global driver=cfi.pflash01,property=secure,value=on
      -drive "if=pflash,format=raw,readonly=on,file=$ovmf_dir/OVMF_CODE_4M.secboot.fd"
      -drive "if=pflash,format=raw,file=$vars")
    ;;
  bios)
    # No pflash drives: QEMU uses SeaBIOS.
    args+=(-machine "pc,accel=$accel")
    ;;
  *)
    echo "unknown mode: $mode" >&2
    exit 2
    ;;
esac

timeout "$timeout_s" "$qemu" "${args[@]}" &
pid=$!

for _ in $(seq 1 "$timeout_s"); do
  if grep -q 'login:' "$log"; then
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    if [[ $mode == secureboot ]] && ! grep -qi 'secure boot enabled' "$log"; then
      echo "FAIL [$mode]: login reached but the kernel did not report Secure Boot enabled" >&2
      exit 1
    fi
    echo "PASS [$mode, $accel]: login prompt reached"
    exit 0
  fi
  if ! kill -0 "$pid" 2>/dev/null; then break; fi
  sleep 1
done
kill "$pid" 2>/dev/null || true
echo "FAIL [$mode, $accel]: no login prompt within ${timeout_s}s; last console lines:" >&2
tail -20 "$log" >&2
exit 1
