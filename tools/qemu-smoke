# Layout of a --read-only-root image, seen from inside: the root is an overlay whose lower layer is the read-only
# root partition and whose upper layer is memory, /var and /home come from the state partition, and a write to the
# system is possible (so the programs that write to /etc and /usr still work) but is not on the disk.
run_layout() {
  exec 3<>"$fifo.in"
  local cr=$'\r' cmd
  printf 'root%s' "$cr" >&3
  wait_for 'root@' 60 || {
    echo "FAIL [layout]: no root shell on the serial console (image built without --debug-login?)" >&2
    return 1
  }
  # shellcheck disable=SC2016
  local -a cmds=(
    'echo L1_root_$(findmnt -no FSTYPE /)_lower_$(findmnt -no OPTIONS /media/ck-ro | cut -d, -f1)_$(findmnt -no LABEL /media/ck-ro 2>/dev/null || lsblk -no LABEL $(findmnt -no SOURCE /media/ck-ro))'
    'echo L2_memory_$(findmnt -no FSTYPE /media/ck-rw)_state_$(findmnt -no FSTYPE,OPTIONS /state | cut -d, -f1 | tr " " _)'
    'echo L3_var_$(findmnt -no LABEL,FSROOT /var | tr " " :)_home_$(findmnt -no LABEL,FSROOT /home | tr " " :)'
    'touch /usr/ck-layout-probe && echo L4_write_ok_$(test -e /media/ck-ro/usr/ck-layout-probe && echo ON_DISK || echo not_on_disk)'
    'echo L5_state_$(df --output=size -B1M /state | tail -1 | tr -d " ")_mb_fstab_root_$(grep -c " / " /etc/fstab)'
    # What a failed run needs to be understood: the kernel command line, what the initramfs holds, what the kernel said.
    'cat /proc/cmdline; lsinitramfs /boot/initrd.img-$(uname -r) | grep -E "ck-|overlay|verity"; dmesg | grep -iE "overlay|verity|ck-" | tail -8; findmnt -rno TARGET,FSTYPE,SOURCE / /media/ck-ro'
    'echo L_$((1+1))_DONE'
  )
  if [[ $mode == verity || $mode == signed ]]; then
    # The root partition is a dm-verity device with the hash tree on CKVERITY, and the kernel was given the root hash.
    # shellcheck disable=SC2016
    cmds=(
      'echo L6_verity_$(veritysetup status ckroot | awk "\$1==\"type:\" {print \$2}")_$(veritysetup status ckroot | awk "\$1==\"status:\" {print \$2}")_source_$(findmnt -no SOURCE /media/ck-ro)'
      'echo L7_hashdev_$(lsblk -no PARTLABEL $(veritysetup status ckroot | awk "/hash device:/ {print \$3}"))_hashlen_$(grep -o "ck.roothash=[0-9a-f]*" /proc/cmdline | cut -d= -f2 | tr -d "[:space:]" | wc -c)'
      "${cmds[@]}"
    )
  fi
  for cmd in "${cmds[@]}"; do printf '%s%s' "$cmd" "$cr" >&3; done
  wait_for 'L_2_DONE' 120 || {
    echo "FAIL [layout]: the guest did not finish the checks" >&2
    return 1
  }
  local failed=0
  expect() { # expect MARKER DESCRIPTION
    if grep -q "$1" "$log"; then echo "ok   $2"; else
      echo "FAIL $2 (wanted $1)" >&2
      failed=1
    fi
  }
  expect 'L1_root_overlay_lower_ro_CKROOT' 'the root is an overlay over the CKROOT partition, mounted read-only'
  expect 'L2_memory_tmpfs_state_ext4' 'the memory layer is a tmpfs and CKSTATE is ext4'
  expect 'L3_var_CKSTATE:/var_home_CKSTATE:/home' '/var and /home come from the state partition'
  expect 'L4_write_ok_not_on_disk' 'a write to the system works and does not reach the root partition'
  expect 'L5_state_[0-9]*_mb_fstab_root_0' 'the state partition has room and fstab has no line for /'
  if [[ $mode == verity || $mode == signed ]]; then
    expect 'L6_verity_VERITY_verified_source_/dev/mapper/ckroot' 'the root is a dm-verity device whose blocks verified'
    expect 'L7_hashdev_CKVERITY_hashlen_64' 'the hash tree is on the CKVERITY partition and the kernel command line carries a 64 character root hash'
  fi
  return "$failed"
}

started=$SECONDS
died=0
for _ in $(seq 1 "$timeout_s"); do
  # These two must never reach a login prompt; the loop below waits the whole time to be sure.
  if [[ $mode == refused || $mode == tamper ]] && grep -q 'login:' "$log"; then
    echo "FAIL [$mode]: the login prompt was reached, but this boot must be refused" >&2
    exit 1
  fi
  if [[ $mode == layout || $mode == verity || $mode == signed ]] && grep -q 'login:' "$log"; then
    rc=0
    run_layout || rc=1
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    if [[ $rc -eq 0 ]]; then
      if [[ $mode == signed ]] && ! grep -qi 'secure boot enabled' "$log"; then
        echo "FAIL [signed]: the checks passed but the kernel did not report Secure Boot enabled" >&2
        exit 1
      fi
      echo "PASS [$mode, $accel]"
      exit 0
    fi
    echo "FAIL [$mode, $accel]; last console lines:" >&2
    tail -40 "$log" >&2
    exit 1
  fi
  if [[ $mode == checks ]] && grep -q 'login:' "$log"; then
    rc=0
    run_checks || rc=1
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    if [[ $rc -eq 0 ]]; then
      echo "PASS [checks, $accel]"
      exit 0
    fi
    echo "FAIL [checks, $accel]; last console lines:" >&2
    tail -70 "$log" >&2
    exit 1
  fi
  if grep -q 'login:' "$log"; then
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    if [[ $mode == secureboot ]] && ! grep -qi 'secure boot enabled' "$log"; then
      echo "FAIL [$mode]: login reached but the kernel did not report Secure Boot enabled" >&2
      exit 1
    fi
    echo "PASS [$mode, $accel]: login prompt reached"
    exit 0
  fi
  if ! kill -0 "$pid" 2>/dev/null; then
    # QEMU stopping by itself well before its time is up is a failure, also for a boot that must be refused.
    [[ $mode == refused ]] && ((SECONDS - started < timeout_s - 5)) && died=1
    break
  fi
  sleep 1
done
kill "$pid" 2>/dev/null || true
if [[ $mode == refused || $mode == tamper ]]; then
  if [[ $died -eq 1 ]]; then
    echo "FAIL [$mode]: QEMU stopped by itself; last console lines:" >&2
    tail -20 "$log" >&2
    exit 1
  fi
  # shim refuses the image before the kernel starts, so nothing of the kernel may be in the log.
  if [[ $mode == refused ]] && grep -q 'Linux version' "$log"; then
    echo "FAIL [refused]: the kernel started, so the signed image was not refused; last console lines:" >&2
    tail -20 "$log" >&2
    exit 1
  fi
  # No login in the whole time is the wanted result. A tampered root must also say why (verity or the failed mount),
  # or the test would pass on a machine that never started.
  if [[ $mode == tamper ]] && ! grep -qiE 'data block [0-9]+ is corrupted|verity.*corrupt|Attempted to kill init|I/O error' "$log"; then
    echo "FAIL [tamper]: no login, but the log does not show the verity failure; last console lines:" >&2
    tail -30 "$log" >&2
    exit 1
  fi
  echo "PASS [$mode, $accel]: no login prompt within ${timeout_s}s, as wanted"
  exit 0
fi
echo "FAIL [$mode, $accel]: no login prompt within ${timeout_s}s; last console lines:" >&2
tail -20 "$log" >&2
exit 1
