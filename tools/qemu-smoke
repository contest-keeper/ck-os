#!/usr/bin/env bash
# Boot a built image in QEMU and wait for the login prompt on the serial console.
# Usage: tools/qemu-smoke IMAGE [MODE] [timeout-seconds]
#   MODE: uefi | secureboot | bios | all (default all). "all" runs the three boot modes one after another
#   and exits non-zero if any of them fails.
#   MODE layout | verity: for an image built with --read-only-root (layout) or --verity (verity, UEFI only). Boots UEFI, logs in as root and checks the memory layer over the
#   read-only root and the state partition. Needs --debug-login.
#   MODE signed | refused | tamper: for an image built with --verity and --uki-key (CK_UKI_CERT is its certificate, PEM).
#     signed:  Secure Boot with the Microsoft keys and the certificate added to the firmware's db, as an organizer's MOK
#              enrolment would do; must boot (shim, then the signed UKI), report "Secure boot enabled" and pass the
#              verity checks of the verity mode.
#     refused: Secure Boot without the certificate; must NOT reach the login prompt, because shim refuses the UKI.
#     tamper:  a copy of the image with the first block of the root partition overwritten, booted like verity mode; must
#              NOT reach the login prompt, and the log must show the verity or mount failure. Takes CK_TAMPER_MODE=refused
#              to run the tamper step on a refused boot instead. Needs sfdisk. Not run: shim with the MOK list (see
#              docs/protected-image.md); the test enrols the certificate in the firmware's db instead.
#   MODE checks: boots UEFI, logs in as root on the serial console and checks the Keeper parts from inside
#   (network lock, Squid, capture, allowlist, CA trust). Needs an image built with --debug-login, QEMU's
#   user network and internet access (it fetches https://example.com through Squid). Linux only.
# Needs qemu-system-x86_64 and OVMF (package ovmf). Acceleration: KVM when /dev/kvm is writable (Linux, CI),
# WHPX on Windows (Git Bash with a Windows QEMU), else slow software emulation. Override with QEMU_ACCEL.
# Secure Boot mode also checks that the kernel reports "Secure boot enabled", so a boot that quietly
# skipped Secure Boot cannot pass.
set -euo pipefail

image=${1:?usage: qemu-smoke IMAGE [uefi|secureboot|bios|all] [timeout]}
mode=${2:-all}
timeout_s=${3:-240}

if [[ $mode == all ]]; then
  failed=0
  for m in uefi secureboot bios; do
    "$0" "$image" "$m" "$timeout_s" || failed=1
  done
  exit "$failed"
fi

ovmf_dir=${OVMF_DIR:-/usr/share/OVMF}
qemu=${QEMU:-qemu-system-x86_64}

accel=${QEMU_ACCEL:-}
if [[ -z $accel ]]; then
  case $(uname -s) in
    MINGW* | MSYS* | CYGWIN*) accel=whpx ;;
    *) if [[ -w /dev/kvm ]]; then accel=kvm; else accel=tcg; fi ;;
  esac
fi

log=$(mktemp)
vars=$(mktemp)
usbdisk=$(mktemp)
# CK_SMOKE_LOG=FILE keeps the whole serial log there, for looking at a failed run. CK_SMOKE_EXTRA='cmd' runs one more
# command in the guest (checks mode), for looking into a failure.
trap '[[ -n ${CK_SMOKE_LOG:-} ]] && cp "$log" "$CK_SMOKE_LOG"; rm -f "$log" "$vars" "$usbdisk" "${tampered:-}" "$fifo.in" "$fifo.out"; kill $(jobs -p) 2>/dev/null || true' EXIT

# The tamper mode boots a copy whose first root block is overwritten, so verity must refuse it. The copy is sparse.
tampered=
if [[ $mode == tamper ]]; then
  tampered=$(mktemp)
  cp --sparse=always "$image" "$tampered"
  root_start=$(sfdisk -d "$tampered" | sed -n 's/.*start= *\([0-9]*\),.*name="CKROOT".*/\1/p')
  [[ -n $root_start ]] || {
    echo "FAIL [tamper]: the image has no partition named CKROOT (built without --read-only-root?)" >&2
    exit 1
  }
  # The 20th block of systemd's own program file, in the root's 4 KiB blocks (the partition starts on a block boundary).
  victim=$(debugfs -R "bmap /usr/lib/systemd/systemd 20" "$tampered?offset=$((root_start * 512))" 2>/dev/null | tail -1)
  [[ $victim =~ ^[0-9]+$ && $victim -gt 0 ]] || {
    echo "FAIL [tamper]: could not find a block of /usr/lib/systemd/systemd in the root (got '$victim')" >&2
    exit 1
  }
  head -c 4096 /dev/zero | tr '\0' '\377' | dd of="$tampered" bs=4096 seek=$((root_start * 512 / 4096 + victim)) conv=notrunc status=none
  image=$tampered
fi
# snapshot=on keeps the image unchanged, so the same file can be booted again or flashed.
args=(-m 3072 -smp 2 -display none -drive "file=$image,format=raw,snapshot=on" -no-reboot)
serial=(-serial "file:$log")
fifo=
if [[ $mode == checks || $mode == layout || $mode == verity || $mode == signed ]]; then
  # A pipe lets this script type into the guest's serial console as well as read it.
  fifo=$(mktemp -u)
  mkfifo "$fifo.in" "$fifo.out"
  serial=(-serial "pipe:$fifo")
  # A second disk on USB, for the check that other USB storage can be switched off.
  truncate -s 8M "$usbdisk"
  args+=(-device qemu-xhci -drive "if=none,id=ckusb,file=$usbdisk,format=raw" -device "usb-storage,drive=ckusb")
  cat "$fifo.out" >"$log" &
fi

case $mode in
  uefi | checks | layout | verity | tamper)
    cp "$ovmf_dir/OVMF_VARS_4M.fd" "$vars"
    args+=(-machine "q35,accel=$accel"
      -drive "if=pflash,format=raw,readonly=on,file=$ovmf_dir/OVMF_CODE_4M.fd"
      -drive "if=pflash,format=raw,file=$vars")
    ;;
  signed | refused)
    # The same Secure Boot firmware as secureboot mode. For signed, the image's certificate joins the firmware's db
    # (shim also accepts what db accepts), which is what an enrolled MOK entry gives a laptop.
    if [[ $mode == signed ]]; then
      command -v virt-fw-vars >/dev/null || {
        echo "FAIL [signed]: virt-fw-vars (package virt-firmware) is needed to enrol the certificate" >&2
        exit 1
      }
      [[ -r ${CK_UKI_CERT:-} ]] || {
        echo "FAIL [signed]: set CK_UKI_CERT to the PEM certificate the image's boot image was signed with" >&2
        exit 1
      }
      virt-fw-vars --input "$ovmf_dir/OVMF_VARS_4M.ms.fd" --output "$vars" --add-db 6b8a1c10-0000-4c4b-8000-0000000000c1 "$CK_UKI_CERT"
    else
      cp "$ovmf_dir/OVMF_VARS_4M.ms.fd" "$vars"
    fi
    # shellcheck disable=SC2054 # the commas belong to the -machine option string
    args+=(-machine "q35,accel=$accel,smm=on"
      -global driver=cfi.pflash01,property=secure,value=on
      -drive "if=pflash,format=raw,readonly=on,file=$ovmf_dir/OVMF_CODE_4M.secboot.fd"
      -drive "if=pflash,format=raw,file=$vars")
    ;;
  secureboot)
    # OVMF_VARS_4M.ms.fd already holds the Microsoft keys with Secure Boot enabled; Canonical's shim is
    # signed by the Microsoft UEFI CA. SMM must be on for the secure firmware.
    cp "$ovmf_dir/OVMF_VARS_4M.ms.fd" "$vars"
    # shellcheck disable=SC2054 # the commas belong to the -machine option string
    args+=(-machine "q35,accel=$accel,smm=on"
      -global driver=cfi.pflash01,property=secure,value=on
      -drive "if=pflash,format=raw,readonly=on,file=$ovmf_dir/OVMF_CODE_4M.secboot.fd"
      -drive "if=pflash,format=raw,file=$vars")
    ;;
  bios)
    # No pflash drives: QEMU uses SeaBIOS.
    args+=(-machine "pc,accel=$accel")
    ;;
  *)
    echo "unknown mode: $mode" >&2
    exit 2
    ;;
esac

timeout "$timeout_s" "$qemu" "${args[@]}" "${serial[@]}" &
pid=$!

# Waits up to $2 seconds for the text $1 in the serial log; returns 1 if it never comes.
wait_for() {
  local _
  for _ in $(seq 1 "$2"); do
    grep -q "$1" "$log" && return 0
    sleep 1
  done
  return 1
}

# Runs the checks inside the guest. Each prints a marker line the test then looks for.
run_checks() {
  exec 3<>"$fifo.in"
  local cr=$'\r' cmd
  printf 'root%s' "$cr" >&3
  wait_for 'root@' 60 || {
    echo "FAIL [checks]: no root shell on the serial console (image built without --debug-login?)" >&2
    return 1
  }
  local proxy='-x http://127.0.0.1:3128 --max-time 40 -s -o /dev/null'
  # The guest shell expands the $(...) and the curl format, not this one.
  # Compute marker suffixes so the echoed commands cannot match the markers they are meant to print.
  # shellcheck disable=SC2016
  local -a cmds=(
    'echo CK1_$(systemctl is-active ck-netlock squid ck-capture ck-squid-ca | tr -s "\n" "_")'
    'nft list table inet ck_netlock >/dev/null && echo CK2_netlock_table'
    'findmnt -nr -M /ck-config -o FSTYPE,VFS-OPTIONS | grep -qE "^vfat (.*,)?ro(,|$)" && echo CK39_ckconfig_$((2+3))'
    'test "$(stat -c %u:%g:%a /ck-config)" = 0:0:700 && ! runuser -u contestant -- ls /ck-config >/dev/null 2>&1 && echo CK40_ckconfig_$((1+1))'
    # systemctl on Noble quotes unit names containing backslashes and doubles the backslashes.
    'mount_unit=$(systemd-escape --path --suffix=mount /ck-config); systemctl show -p After --value ck-config.service | tr " " "\n" | grep -Fxq -e "$mount_unit" -e "$(printf "\"%q\"" "$mount_unit")" && echo CK41_ckconfig_$((3+4))'
    'runuser -u contestant -- notify-send --version >/dev/null && echo CK42_notify_$((3+5))'
    'device=$(systemd-escape --path --suffix=device /dev/disk/by-partlabel/CKCONFIG); test "$(systemctl show -p JobRunningTimeoutUSec --value "$device")" = 30s && echo CK43_ckconfig_wait_$((3+6))'
    # An unsigned settings file on CKCONFIG must be refused: exit 3, trust marker "rejected", nothing applied.
    'r=/tmp/ck45; rm -rf $r; mkdir -p $r/ck-config $r/etc/ck; cp /etc/ck/config-public-keys $r/etc/ck/; echo "{}" >$r/ck-config/config.json; ck-agent apply-config --root $r >/dev/null 2>&1; rc=$?; echo CK45_unsigned_${rc}_$(cut -d" " -f1 $r/etc/ck/config.trust)_$(test -e $r/etc/hostname && echo applied || echo untouched)'
    'echo .example.com >/etc/squid/acl_allowed_domains.txt; systemctl restart squid; sleep 3'
    "curl $proxy -w 'CK3_%{http_code}\n' https://example.com/"
    "curl $proxy -w 'CK4_%{http_code}\n' https://example.org/"
    'systemctl stop ck-capture; sleep 1'
    "curl $proxy -w 'CK5_%{http_code}\n' https://example.com/"
    'systemctl start ck-capture; sleep 2'
    "echo CK7_\$(seq 40 | xargs -P 20 -I{} curl $proxy -w '%{http_code}\n' https://example.com/ | sort | uniq -c | tr -s ' \n' '_')"
    "curl $proxy -w 'CK6_%{http_code}\n' https://example.com/"
    'for i in $(seq 60); do pgrep -u contestant -x xfce4-session >/dev/null && break; sleep 2; done; echo CK8_$(pgrep -u contestant -x xfce4-session | wc -l)_session'
    'pkcheck --action-id org.freedesktop.NetworkManager.enable-disable-wifi --process $(pgrep -u contestant -o -x xfce4-session) >/dev/null 2>&1; echo CK9_wifi_switch_$?'
    'p() { pkcheck --action-id "$1" --process $(pgrep -u contestant -o -x xfce4-session) >/dev/null 2>&1; echo $?; }; echo CK46_nmedit_$(p org.freedesktop.NetworkManager.settings.modify.own)_$(p org.freedesktop.NetworkManager.settings.modify.system)_$(p org.freedesktop.NetworkManager.settings.modify.global-dns)'
    'dpkg -s udisks2 >/dev/null 2>&1 && u=installed || u=absent; test -f /etc/polkit-1/rules.d/55-ck-udisks.rules && r=rule || r=norule; echo CK47_udisks_${u}_$r'
    'echo CK48_thunderbolt_$(modprobe -n -v thunderbolt 2>&1 | grep -c "/bin/false")'
    'echo CK49_homes_$(stat -c %a /home/contestant /home/ckadmin | tr -s "
" "_")$(runuser -u contestant -- ls /home/ckadmin >/dev/null 2>&1 && echo readable || echo denied)'
    'rm -f /run/ck-reset-allowed; PAM_USER=ckreset ck-screen pam; a=$?; ck-reset-allow >/dev/null; PAM_USER=ckreset ck-screen pam; b=$?; touch -d "90 seconds ago" /run/ck-reset-allowed; PAM_USER=ckreset ck-screen pam; d=$?; touch -d "5 minutes ago" /run/ck-reset-allowed; PAM_USER=ckreset ck-screen pam; c=$?; rm -f /run/ck-reset-allowed; echo CK50_resetlogin_${a}_${b}_${d}_$c'
    'echo CK51_lockdown_$(grep -c lockdown=integrity /proc/cmdline)_$(grep -o "\[[a-z]*\]" /sys/kernel/security/lockdown | tr -d "[]")'
    'timeout 3 bash -c "echo >/dev/tcp/10.0.2.2/9" 2>/dev/null; r=$?; echo CK52_rootnet_${r}_slices_$(for u in squid NetworkManager systemd-timesyncd ck-uplink; do systemctl show -p Slice --value $u.service; done | grep -cx cknet.slice)'
    'echo CK53_hardened_$(for u in ck-uplink ck-config; do systemctl show -p LockPersonality -p RestrictNamespaces -p SystemCallArchitectures --value $u.service | grep -cE "yes|native"; done | tr "
" "_")failed_$(systemctl is-failed ck-config.service ck-uplink.service | grep -c failed)'
    'echo CK54_mounts_$(findmnt -no OPTIONS /tmp | grep nosuid | grep -c nodev)_$(findmnt -no OPTIONS /home | grep nosuid | grep -c nodev)_$(findmnt -no OPTIONS /tmp | grep -c noexec)_$(findmnt -no OPTIONS /var/tmp | grep nosuid | grep -c nodev)'
    'echo "ACTION==\"add\", SUBSYSTEM==\"usb\", ENV{DEVTYPE}==\"usb_interface\", ATTR{bInterfaceClass}==\"08\", ATTR{authorized}=\"0\"" >/etc/udev/rules.d/60-ck-smoke-usb.rules; udevadm control --reload; udevadm trigger --subsystem-match=usb --action=add; udevadm settle; n=0; a=; for i in /sys/bus/usb/devices/*:*; do [ "$(cat $i/bInterfaceClass 2>/dev/null)" = 08 ] && n=$((n+1)) && a="$a$(cat $i/authorized)"; done; rm -f /etc/udev/rules.d/60-ck-smoke-usb.rules; echo CK59_usbstorage_${n}_${a}'
    'test -x /usr/bin/nm-applet && test -f /etc/xdg/autostart/nm-applet.desktop && grep -q systray /etc/xdg/xfce4/panel/default.xml && echo CK10_network_menu_ok'
    'id -nG contestant | tr " " "
" | grep -xqE "sudo|adm|lpadmin|root" && echo CK11_bad_groups || echo CK11_groups_ok'
    'su -s /bin/sh contestant -c "sudo -n true" >/dev/null 2>&1; echo CK12_sudo_$?'
    'timeout 120 su - contestant -c "firefox --headless --screenshot /tmp/ff.png about:blank" >/dev/null 2>&1; echo CK13_firefox_$?'
    'echo CK14_ca_$(certutil -L -d sql:$(dirname $(find /home/contestant -name cert9.db | head -1)) 2>/dev/null | grep -c "Keeper OS contest CA")_in_firefox'
    'dpkg -s firefox | grep -q "^Version: 160.0.1" && ! command -v snap >/dev/null && echo CK15_mozilla_deb_no_snap'
    'su - contestant -c "ck-toolchains --run"; echo CK16_exit_$?'
    'for c in codium codeblocks geany clangd; do command -v $c >/dev/null || echo missing_$c; done; echo CK17_ms_repo_files_$(ls /etc/apt/sources.list.d/ | grep -ciE "vscode|microsoft"); test -f /usr/share/codium/resources/app/extensions/llvm-vs-code-extensions.vscode-clangd/package.json && echo CK19_clangd_$((3+4)); grep -q chat.disableAIFeatures /home/contestant/.config/VSCodium/User/settings.json && echo CK20_ai_$((1+1)); dpkg -l code 2>/dev/null | grep -c ^ii | sed s/^/CK21_msvscode_/'
    '. /etc/os-release; echo CK22_name_${ID}_$((1+1)); grep -ciE "^(menuentry|submenu).*ubuntu" /boot/grub/grub.cfg | sed s/^/CK23_grub_ubuntu_/; dpkg -l "*xubuntu-artwork*" "ubuntu-mono" "xubuntu-wallpapers" "plymouth-theme-*ubuntu*" 2>/dev/null | grep -c ^ii | sed s/^/CK24_brandpkgs_/; test -s /usr/share/doc/keeper-os/SOURCE-OFFER.txt && echo CK25_offer_$((2+3))'
    'echo CK26_networkd_$(systemctl is-enabled systemd-networkd 2>&1)_$(systemctl is-active systemd-networkd 2>&1)_nm_$(systemctl is-active NetworkManager)'
    'echo CK27_terms_$(command -v gnome-terminal xfce4-terminal | wc -l)_xterm_$(command -v xterm | wc -l)'
    'u=$(id -u contestant); q() { runuser -u contestant -- env DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$u/bus xfconf-query "$@"; }; echo CK28_shortcuts_terminal_$(q -c xfce4-keyboard-shortcuts -lv 2>&1 | grep -ci terminal)_alttab_$(q -c xfce4-keyboard-shortcuts -lv 2>&1 | grep -c "default/.Alt.Tab")'
    'echo CK29_kiosk_$(grep -c CustomizePanel=NONE /etc/xdg/xfce4/kiosk/kioskrc)_vt_$(grep -c DontVTSwitch /etc/X11/xorg.conf.d/50-ck-novtswitch.conf)'
    'echo CK30_desktop_$(ls /home/contestant/Desktop | wc -l)_exec_$(find /home/contestant/Desktop -name "*.desktop" -perm -u+x | wc -l)_owner_$(stat -c %U /home/contestant/Desktop/firefox.desktop)'
    'echo CK31_menu_$(grep -c "<Filename>" /etc/xdg/xdg-xubuntu/menus/xfce-applications.menu)_panel_$(pgrep -u contestant -c xfce4-panel)'
    'runuser -u contestant -- systemctl start ck-refresh-connection.service >/dev/null 2>&1; echo CK32_refreshunit_$?'
    'runuser -u contestant -- systemctl --no-ask-password restart squid.service >/dev/null 2>&1; echo CK33_squidrestart_$?'
    'runuser -u contestant -- ck-refresh-connection --no-gui; echo CK34_refresh_$?'
    'p() { pkcheck --action-id "$1" --process $(pgrep -u contestant -o -x xfce4-session) >/dev/null 2>&1; echo $?; }; echo CK44_power_$(p org.freedesktop.login1.power-off)_reboot_$(p org.freedesktop.login1.reboot)_firmware_$(p org.freedesktop.login1.set-reboot)_suspend_$(p org.freedesktop.login1.suspend)'
    ${CK_SMOKE_EXTRA:+"$CK_SMOKE_EXTRA"}
    'echo CK18_java_store_$(keytool -list -cacerts -storepass changeit 2>/dev/null | grep -ci ck-squid-ca)'
    'journalctl -u ck-squid-ca -u squid -u ck-capture --no-pager | grep -v "squid\[" | tail -12'
    'ls -l /etc/resolv.conf; cat /run/systemd/resolve/resolv.conf; nmcli -t device; ip -br addr; systemctl is-active NetworkManager systemd-resolved'
    'runuser -u ckreset -- sleep 40 & sleep 1; pkcheck --action-id org.freedesktop.systemd1.manage-units --detail unit ck-team-reset.service --detail verb start --process $(pgrep -u ckreset -o -x sleep) >/dev/null 2>&1; echo CK35_resetlogin_$?'
    'pkcheck --action-id org.freedesktop.systemd1.manage-units --detail unit ck-team-reset.service --detail verb start --process $(pgrep -u contestant -o -x xfce4-session) >/dev/null 2>&1; echo CK36_contestantreset_$?'
    'uid0=$(id -u contestant); touch /home/contestant/Desktop/junk-by-contestant /home/contestant/.junk-by-contestant; systemctl start ck-team-reset.service; echo CK37_reset_$?'
    'for i in $(seq 60); do pgrep -u contestant -x xfce4-session >/dev/null && break; sleep 2; done; echo CK38_after_$(ls /home/contestant/Desktop/junk-by-contestant /home/contestant/.junk-by-contestant 2>/dev/null | wc -l)_junk_launchers_$(ls /home/contestant/Desktop | wc -l)_session_$(pgrep -u contestant -c -x xfce4-session)_uid_$([ "$(id -u contestant)" = "$uid0" ] && echo same)'
    'echo CK55_ca_$(openssl x509 -checkend 6048000 -noout -in /etc/ck/squid-ca/ca.crt >/dev/null; echo $?)_$(openssl x509 -checkend 4320000 -noout -in /etc/ck/squid-ca/ca.crt >/dev/null; echo $?)'
    'for i in $(seq 90); do [ -n "$(systemctl show ck-squid-ca-renew.service -p ExecMainStartTimestamp --value)" ] && break; sleep 2; done; echo CK58_renew_timer_$(systemctl is-enabled ck-squid-ca-renew.timer)_ran_$([ -n "$(systemctl show ck-squid-ca-renew.service -p ExecMainStartTimestamp --value)" ] && echo 1 || echo 0)'
    'f=/etc/ck/squid-ca; old=$(openssl x509 -in $f/ca.crt -noout -subject); openssl req -x509 -new -key $f/ca.key -days 1 -subj /CN=old-ca -out $f/ca.crt && /usr/local/sbin/ck-squid-ca >/dev/null 2>&1; new=$(openssl x509 -in $f/ca.crt -noout -subject); fp=$(openssl x509 -in $f/ca.crt -noout -fingerprint -sha256 | cut -d= -f2); echo CK56_regen_$([ "$new" != "$old" ] && echo changed)_$(openssl x509 -checkend 4320000 -noout -in $f/ca.crt >/dev/null; echo $?)_$(keytool -list -cacerts -storepass changeit 2>/dev/null | grep -c "$fp")_$(cmp -s $f/ca.crt /usr/local/share/ca-certificates/ck-squid-ca.crt && echo trusted)'
    'f=/etc/ck/squid-ca; old=$(openssl x509 -in $f/ca.crt -noout -subject); openssl req -x509 -new -key $f/ca.key -days 1 -subj /CN=expired-ca -out $f/ca.crt; systemctl start ck-squid-ca-renew.service; echo CK57_renew_$([ "$(openssl x509 -in $f/ca.crt -noout -subject)" != "$old" ] && echo changed)_$(systemctl is-active squid.service)_$(systemctl is-enabled ck-squid-ca-renew.timer)'
    'echo CK_$((1+1))_DONE'
  )
  for cmd in "${cmds[@]}"; do printf '%s%s' "$cmd" "$cr" >&3; done
  wait_for 'CK_2_DONE' 600 || {
    echo "FAIL [checks]: the guest did not finish the checks" >&2
    return 1
  }
  local failed=0
  expect() { # expect MARKER DESCRIPTION
    if grep -q "$1" "$log"; then echo "ok   $2"; else
      echo "FAIL $2 (wanted $1)" >&2
      failed=1
    fi
  }
  expect 'CK1_active_active_active_active_' 'ck-netlock, squid, ck-capture and ck-squid-ca are active'
  expect 'CK2_netlock_table' 'the network lock table is loaded'
  expect 'CK39_ckconfig_5' 'CKCONFIG is mounted read-only at /ck-config'
  expect 'CK40_ckconfig_2' 'only root can read the CKCONFIG partition'
  expect 'CK41_ckconfig_7' 'ck-config is ordered after the CKCONFIG mount'
  expect 'CK42_notify_8' 'the contestant session can launch notify-send for Hub messages'
  expect 'CK43_ckconfig_wait_9' 'CKCONFIG has 30 seconds to become available on slow media'
  expect 'CK45_unsigned_3_rejected_untouched' 'the stick refuses a settings file the Hub did not sign'
  expect 'CK3_200' 'an allowed site works through Squid (CA trusted, capture up)'
  if grep -q 'CK4_200' "$log"; then
    echo "FAIL a site that is not allowed was reachable" >&2
    failed=1
  else echo "ok   a site that is not allowed is refused"; fi
  # Capture down: fail closed (decision 4), so the allowed site must not answer 200.
  if grep -q 'CK5_200' "$log"; then
    echo "FAIL the allowed site passed unobserved with ck-capture stopped" >&2
    failed=1
  else echo "ok   the allowed site is refused while ck-capture is stopped"; fi
  expect 'CK6_200' 'the allowed site works again once ck-capture is back'
  expect 'CK7__40_200_' '40 parallel requests (20 at a time) to the allowed site all succeed'
  expect 'CK8_1_session' 'the contestant is logged in on the desktop by itself (autologin)'
  # Contestants need Wi-Fi (decision of 2026-11-20): the standard network menu is in the panel and
  # polkit lets the contestant's session switch Wi-Fi on and off.
  expect 'CK9_wifi_switch_0' 'polkit lets the contestant switch Wi-Fi on and off'
  expect 'CK46_nmedit_1_1_1' 'polkit does not let the contestant add or change a network connection or its DNS'
  expect 'CK47_udisks_absent_rule' 'udisks2 is not installed (nothing mounts disks for the contestant) and its polkit deny rule is in place'
  expect 'CK48_thunderbolt_1' 'the Thunderbolt driver cannot be loaded'
