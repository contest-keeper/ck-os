[Unit]
Requires=cknet.slice
After=cknet.slice
Description=Keeper OS: upload completed recordings and apply local retention
After=ck-config.service
ConditionPathExists=/etc/ck/config.json

[Service]
Slice=cknet.slice
Type=oneshot
ExecStart=/usr/local/bin/ck-agent upload-recordings
TimeoutStartSec=180
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
StateDirectory=ck/recordings
StateDirectoryMode=0700
# Hardening, as for ck-uplink: what the upload does needs none of these, so a bug in it cannot use them.
CapabilityBoundingSet=~CAP_SYS_MODULE CAP_SYS_RAWIO CAP_SYS_PTRACE CAP_SYS_TIME CAP_NET_RAW CAP_BPF CAP_PERFMON CAP_SYS_TTY_CONFIG CAP_WAKE_ALARM CAP_LINUX_IMMUTABLE CAP_MKNOD CAP_SYS_CHROOT
LockPersonality=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ProtectHostname=yes
ProtectKernelTunables=yes
