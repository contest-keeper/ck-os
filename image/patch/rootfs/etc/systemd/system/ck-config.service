[Unit]
Description=Keeper OS: apply the admin's settings
# Try CKCONFIG before reading settings. Older images only have the EFI partition.
Wants=ck\x2dconfig.mount
After=ck\x2dconfig.mount
RequiresMountsFor=/boot/efi
# Squid, the desktop and the recorder read the applied settings at start.
Before=squid.service display-manager.service ck-recorder.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/ck-agent apply-config
StateDirectory=ck/enrolment
StateDirectoryMode=0700
# Hardening: what the agent does needs none of these, so a bug in it cannot use them.
CapabilityBoundingSet=~CAP_SYS_MODULE CAP_SYS_RAWIO CAP_SYS_PTRACE CAP_SYS_TIME CAP_NET_RAW CAP_BPF CAP_PERFMON CAP_SYS_TTY_CONFIG CAP_WAKE_ALARM CAP_LINUX_IMMUTABLE CAP_MKNOD CAP_SYS_CHROOT
LockPersonality=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_NETLINK
# Exit code 3 means there are no settings, so the image keeps its defaults. That is a normal
# state for a stick that was never configured, not a failure.
SuccessExitStatus=3

[Install]
WantedBy=multi-user.target
