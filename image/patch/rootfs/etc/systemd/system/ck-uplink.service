[Unit]
Requires=cknet.slice
After=cknet.slice
Description=Keeper OS: send heartbeats to the Hub
# The settings and the stick's secret are written by ck-config, so wait for it. A stick whose
# settings name no server, or none at all, has nothing to report and this service ends at once.
After=ck-config.service network-online.target
Wants=network-online.target

[Service]
Slice=cknet.slice
ExecStart=/usr/local/bin/ck-agent uplink
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectHome=tmpfs
# Hub messages go to the active desktop session over its D-Bus socket.
BindReadOnlyPaths=/run/user
ProtectSystem=strict
# The queue of events waiting for the Hub, created root-only by systemd.
StateDirectory=ck/queue ck/enrolment
StateDirectoryMode=0700
# Hardening: what the agent does needs none of these, so a bug in it cannot use them.
CapabilityBoundingSet=~CAP_SYS_MODULE CAP_SYS_RAWIO CAP_SYS_PTRACE CAP_SYS_TIME CAP_NET_RAW CAP_BPF CAP_PERFMON CAP_SYS_TTY_CONFIG CAP_WAKE_ALARM CAP_LINUX_IMMUTABLE CAP_MKNOD CAP_SYS_CHROOT
LockPersonality=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ProtectHostname=yes
ProtectKernelTunables=yes

[Install]
WantedBy=multi-user.target
