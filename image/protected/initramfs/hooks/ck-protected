#!/bin/sh
# initramfs-tools hook for the read-only root layout (tools/build-image --read-only-root): puts the overlay driver
# into the initramfs for scripts/init-bottom/ck-overlay.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "${1:-}" in
  prereqs)
    prereqs
    exit 0
    ;;
esac
# shellcheck disable=SC1091
. /usr/share/initramfs-tools/hook-functions
manual_add_modules overlay
