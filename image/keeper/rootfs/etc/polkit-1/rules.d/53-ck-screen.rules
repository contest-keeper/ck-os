// Keep unauthenticated users from switching into an administrator's VT or rebooting from the lock greeter.
// The contestant may shut down and restart (decision of 2026-11-20): the Hub shows it, because the stick
// goes offline and starts a new boot. Everything else here stays denied for the contestant.
polkit.addRule(function (action, subject) {
  if (subject.user !== "contestant" && subject.user !== "ckreset" && subject.user !== "lightdm") {
    return;
  }
  if (subject.user === "contestant" &&
      /^org\.freedesktop\.login1\.(power-off|reboot)(-multiple-sessions)?$/.test(action.id)) {
    return polkit.Result.YES;
  }
  if (/^org\.freedesktop\.login1\.(chvt|power-off|reboot|set-reboot|halt|suspend|hibernate|hybrid-sleep)(-|$)/.test(action.id)) {
    return polkit.Result.NO;
  }
});
