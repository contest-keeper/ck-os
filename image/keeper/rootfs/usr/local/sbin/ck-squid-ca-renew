#!/bin/sh
# Run by ck-squid-ca-renew.timer a minute after boot and every 15 minutes after that. A stick whose clock was
# wrong at boot, for example with a flat clock battery, made its CA at the wrong time: once the real time is
# known the CA may be expired or about to expire. Then it is replaced and Squid restarts to use it. Does nothing
# when the CA is fine, or while the clock has not been set (timesyncd has not reached a server yet).
set -eu
if [ "$(timedatectl show -p NTPSynchronized --value)" != yes ]; then
  exit 0
fi
if openssl x509 -checkend 604800 -noout -in /etc/ck/squid-ca/ca.crt >/dev/null 2>&1; then
  exit 0
fi
/usr/local/sbin/ck-squid-ca
systemctl restart squid.service
