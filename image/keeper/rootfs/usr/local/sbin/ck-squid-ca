#!/bin/sh
# Makes this stick's own Squid CA the first time it boots, trusts it on this machine and prepares
# Squid's certificate database. The CA key never leaves the stick.
#
# The CA is short lived: a key copied from a stick's disk stops being useful after a few weeks. A CA with under
# a week left is replaced at boot (before Squid starts) and the old one is taken out of the system trust.
# --force replaces it whatever its dates say (ck-squid-ca-renew uses it for a CA that is not valid yet).
# CK_ROOT is a prefix for the tests; it is empty on the stick.
set -eu
root=${CK_ROOT:-}
dir=$root/etc/ck/squid-ca
trusted=$root/usr/local/share/ca-certificates/ck-squid-ca.crt
ssl_db=$root/var/lib/squid/ssl_db
renewed=
new_ca=
force=
[ "${1:-}" = --force ] && force=1

if [ -n "$force" ] || [ ! -s "$dir/ca.crt" ] || [ ! -s "$dir/ca.key" ] || ! openssl x509 -checkend 604800 -noout -in "$dir/ca.crt" >/dev/null; then
  if [ -e "$trusted" ]; then
    rm -f "$trusted"
    update-ca-certificates
    renewed=1
  fi
  umask 077
  mkdir -p "$dir"
  openssl req -x509 -newkey rsa:2048 -sha256 -nodes -days 60 \
    -subj "/CN=Keeper OS contest CA $(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')" \
    -addext "basicConstraints=critical,CA:TRUE" -addext "keyUsage=critical,keyCertSign,cRLSign" \
    -keyout "$dir/ca.key" -out "$dir/ca.crt"
  rm -f "$trusted"
  new_ca=1
fi
# Squid (user proxy) reads the key; everyone may read the certificate, so the browser can trust it.
chmod 0755 "$dir"
chown root:proxy "$dir/ca.key"
chmod 0640 "$dir/ca.key"
chmod 0644 "$dir/ca.crt"

# The system store, for tools on this machine. Firefox is told about the certificate by its policy file.
if [ ! -e "$trusted" ]; then
  cp "$dir/ca.crt" "$trusted"
  update-ca-certificates
  # The system store is updated, but Java's keeps its entry under the same name, so replace it by hand.
  if [ -n "$renewed" ] && command -v keytool >/dev/null; then
    keytool -delete -cacerts -storepass changeit -alias debian:ck-squid-ca.pem >/dev/null 2>&1 || true
    # Java's store only matters for contestants' Java programs that call https; a failure here must not stop
    # Squid (it Requires this unit), so it is reported and the boot goes on.
    keytool -importcert -noprompt -cacerts -storepass changeit -alias debian:ck-squid-ca.pem -file "$dir/ca.crt" >/dev/null ||
      echo "ck-squid-ca: could not add the CA to Java's certificate store" >&2
  fi
fi

# The folder is not made by the package; certgen runs as proxy and needs to create the database in it.
install -d -o proxy -g proxy -m 0750 "$root/var/lib/squid"
if [ -n "$new_ca" ]; then
  # Squid's certificate database holds leaf certificates signed by the old CA; with the new CA they would be served
  # as they are and no browser would accept them. The new database is made next to the old one and takes its place
  # only when it exists, so a failure here never leaves Squid without a database.
  rm -rf "$ssl_db.new"
  runuser -u proxy -- /usr/lib/squid/security_file_certgen -c -s "$ssl_db.new" -M 16MB
  rm -rf "$ssl_db"
  mv "$ssl_db.new" "$ssl_db"
elif [ ! -d "$ssl_db" ]; then
  runuser -u proxy -- /usr/lib/squid/security_file_certgen -c -s "$ssl_db" -M 16MB
fi
