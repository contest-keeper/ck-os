#!/bin/sh
# Makes this stick's own Squid CA the first time it boots, trusts it on this machine and prepares
# Squid's certificate database. The CA key never leaves the stick.
#
# The CA is short lived: a key copied from a stick's disk stops being useful after a few weeks. A CA with under
# a week left is replaced at boot (before Squid starts) and the old one is taken out of the system trust.
set -eu
dir=/etc/ck/squid-ca
trusted=/usr/local/share/ca-certificates/ck-squid-ca.crt
renewed=

if [ ! -s "$dir/ca.crt" ] || [ ! -s "$dir/ca.key" ] || ! openssl x509 -checkend 604800 -noout -in "$dir/ca.crt" >/dev/null; then
  if [ -e "$trusted" ]; then
    rm -f "$trusted"
    update-ca-certificates
    renewed=1
  fi
  umask 077
  mkdir -p "$dir"
  openssl req -x509 -newkey rsa:2048 -sha256 -nodes -days 60 \
    -subj "/CN=Keeper OS contest CA $(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')" \
    -addext "basicConstraints=critical,CA:TRUE" -addext "keyUsage=critical,keyCertSign,cRLSign" \
    -keyout "$dir/ca.key" -out "$dir/ca.crt"
  rm -f "$trusted"
fi
# Squid (user proxy) reads the key; everyone may read the certificate, so the browser can trust it.
chmod 0755 "$dir"
chown root:proxy "$dir/ca.key"
chmod 0640 "$dir/ca.key"
chmod 0644 "$dir/ca.crt"

# The system store, for tools on this machine. Firefox is told about the certificate by its policy file.
if [ ! -e "$trusted" ]; then
  cp "$dir/ca.crt" "$trusted"
  update-ca-certificates
  # The system store is updated, but Java's keeps its entry under the same name, so replace it by hand.
  if [ -n "$renewed" ] && command -v keytool >/dev/null; then
    keytool -delete -cacerts -storepass changeit -alias debian:ck-squid-ca.pem >/dev/null 2>&1 || true
    keytool -importcert -noprompt -cacerts -storepass changeit -alias debian:ck-squid-ca.pem -file "$dir/ca.crt" >/dev/null
  fi
fi

# The folder is not made by the package; certgen runs as proxy and needs to create the database in it.
install -d -o proxy -g proxy -m 0750 /var/lib/squid
if [ ! -d /var/lib/squid/ssl_db ]; then
  runuser -u proxy -- /usr/lib/squid/security_file_certgen -c -s /var/lib/squid/ssl_db -M 16MB
fi
